/* The main horizontal container */

WebHog {
    layout: vertical;
    background: $surface;
}

SystemInfoDisplay {
    width: 100%;
    layout: horizontal;
    background: $surface;
    overflow-x: auto;
    overflow-y: auto;
}

#bottom-row {
    width: 100%;
    height: 2fr;          
    layout: horizontal;
    overflow: hidden;
}

.panel {
    height: 100%;
    width: 1fr;           
    border: round $primary;
    border-title-align: center;
    border-title-style: bold;
    margin: 0;
    padding: 0 1;
    background: $surface;
    overflow-y: auto;
}

/* ── Per-panel accent colours ── */
.cpu         { border: round $accent; }
.disk-memory { border: round $secondary; }
.network     { border: round $warning; }
.ports       { border: round $success; }
.ai          { border: round $error; }

/* ── CPU core rows ── */
.bar {
    height: 1;
    layout: horizontal;
    margin: 0;
    padding: 0;
}

.bar ProgressBar {
    width: 1fr;
    min-width: 12;
    height: 1;
    margin: 0;
}

.bar Static {
    width: 5;
    text-style: bold;
    content-align: center middle;
}

.status {
    height: auto;
    margin: 0;
    padding: 0;
}

PortsSockets {
    width: 1fr;
    height: 100%;
    layout: vertical;
    padding: 0;
    margin: 0;
}

PortsSockets Static {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

PortsSockets DataTable {
    height: 1fr;     
    width: 100%;
}

.risk {
    display: none;
}

.reason {
    display: none;
}